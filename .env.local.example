# Numaway — environment variables (copy to .env.local and fill in values)
# DO NOT commit .env.local to version control.

# Supabase — public (safe for browser — anon key only, not service key)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Sage proxy URL (defaults to same origin /api/sage/chat on Vercel)
# Override in local dev if running API separately
VITE_SAGE_API_BASE_URL=
