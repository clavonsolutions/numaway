# Numaway — environment variables (copy to .env.local and fill in values)
# DO NOT commit .env.local to version control.

# -----------------------------------------------------------------------
# BROWSER (VITE_* prefix — safe for client bundle)
# -----------------------------------------------------------------------

# Supabase — public anon key only (NEVER use service-role key here)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Sage proxy URL (defaults to same origin /api/sage/chat on Vercel)
# Override in local dev if running the API server separately
VITE_SAGE_API_BASE_URL=

# -----------------------------------------------------------------------
# SERVER-SIDE ONLY (Vercel dashboard / .env.local — never VITE_* prefix)
# These are never exposed to the browser.
# -----------------------------------------------------------------------

# Supabase — server-side copies (can reuse the same values as VITE_ above)
# The api/sage/chat.ts function reads SUPABASE_URL and SUPABASE_ANON_KEY first,
# then falls back to VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Anthropic — NEVER share this key or commit it anywhere
ANTHROPIC_API_KEY=sk-ant-...

# Anthropic model used by the Sage proxy (optional — defaults to claude-3-5-haiku-20241022)
# ESCALATE TO FOUNDER before changing the model (CLAUDE.md policy)
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
