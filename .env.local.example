# Numaway — environment variables (copy to .env.local and fill in values)
# DO NOT commit .env.local to version control.

# -----------------------------------------------------------------------
# BROWSER (VITE_* prefix — safe for client bundle)
# -----------------------------------------------------------------------

# Supabase — public anon key only (NEVER use service-role key here)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Sage proxy base URL.
# Production: leave empty — Nginx proxies /api/* to the API server on the same host.
# Local dev:  set to http://localhost:3001 (where `npm run server:dev` is running).
VITE_SAGE_API_BASE_URL=

# -----------------------------------------------------------------------
# SERVER-SIDE ONLY (Digital Ocean .env / server process environment)
# Set these in the API server's environment, not in the Vite frontend.
# These are never exposed to the browser (no VITE_* prefix).
# -----------------------------------------------------------------------

# Supabase — used by the API server to validate user sessions.
# Same values as VITE_* above; kept separate so the server can run
# independently without the Vite build step.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Anthropic — NEVER share this key or commit it anywhere.
ANTHROPIC_API_KEY=sk-ant-...

# Anthropic model used by the Sage proxy.
# Defaults to claude-3-5-haiku-20241022 if not set.
# ESCALATE TO FOUNDER before changing the model (CLAUDE.md policy).
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# API server port (defaults to 3001 if not set)
PORT=3001

# CORS — set to the frontend origin in production to restrict cross-origin requests.
# Leave unset in development (allows all origins for local dev convenience).
# Example: CORS_ORIGIN=https://numaway.com
CORS_ORIGIN=
