{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "outDir": "../dist-server",
    "rootDir": "..",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": false
  },
  "include": [
    "../server/**/*.ts",
    "../api/**/*.ts"
  ],
  "exclude": [
    "../src/**/*",
    "../node_modules/**/*",
    "../vite.config.ts",
    "../scripts/**/*"
  ]
}
